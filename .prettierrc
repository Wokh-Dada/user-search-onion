{
    "printWidth": 120,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "bracketSpacing": true,
    "htmlWhitespaceSensitivity": "strict",
    "overrides": [
        {
            "files": "*.component.html",
            "options": {
                "parser": "angular",
                "printWidth": 100
            }
        }
    ]
}
