{
    "extends": ["stylelint-config-standard-scss"],
    "rules": {
        "selector-class-pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:__[a-z][a-z0-9]*(?:-[a-z0-9]+)*)?(?:_[a-z][a-z0-9]*(?:-[a-z0-9]+)*){0,2}$",
        "selector-max-specificity": "0,7,0",
        "max-nesting-depth": 5,
        "scss/dollar-variable-pattern": "^([a-z][a-zA-Z0-9]*|[a-z][a-z0-9]*(-[a-z0-9]+)*)$",
        "scss/at-mixin-pattern": "^([a-z][a-zA-Z0-9]*|[a-z][a-z0-9]*(-[a-z0-9]+)*)$"
    }
}
