{
    "name": "user-search-onion",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "npm run lint:ts && npm run lint:styles",
        "lint:fix": "eslint . --fix --max-warnings=0 && stylelint \"src/**/*.{scss,css}\" --fix --max-warnings=0",
        "lint:styles": "stylelint \"src/**/*.{scss,css}\" --max-warnings=0",
        "lint:ts": "eslint . --max-warnings=0",
        "watch": "ng build --watch --configuration development"
    },
    "private": true,
    "packageManager": "npm@11.6.2",
    "dependencies": {
        "@angular/cdk": "^21.2.14",
        "@angular/common": "^21.2.0",
        "@angular/compiler": "^21.2.0",
        "@angular/core": "^21.2.0",
        "@angular/forms": "^21.2.0",
        "@angular/material": "^21.2.14",
        "@angular/platform-browser": "^21.2.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^21.2.29",
        "@angular/cli": "^21.2.29",
        "@angular/compiler-cli": "^21.2.0",
        "@eslint/js": "10.0.1",
        "@smarttools/eslint-plugin-rxjs": "1.0.22",
        "angular-eslint": "21.4.0",
        "eslint": "10.6.0",
        "eslint-plugin-simple-import-sort": "13.0.0",
        "prettier": "^3.8.1",
        "stylelint": "17.14.0",
        "stylelint-config-standard-scss": "17.0.0",
        "typescript": "~5.9.2",
        "typescript-eslint": "8.63.0"
    }
}
